# Yeedu MCP Server configuration.
#
# Copy to .env and fill in the two required values. .env is gitignored — keep
# the API key out of the repository, out of shell history and out of any MCP
# client config that gets committed.

# ── Required ──────────────────────────────────────────────────────────────────

# Base URL of the Yeedu API, including scheme. No trailing slash.
YEEDU_API_BASE_URL=https://yeedu.example.com

# Yeedu Personal Access Token. Create one in the UI under Settings → Tokens, or
# with: yeedu token create --description "mcp" --timeout=infinity
# This is read by the server process only; it is never passed to a tool and
# never reaches the model.
YEEDU_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────

# Base URL of the Yeedu web UI, if it differs from the API host. Set this to
# have the credential-handoff tools print a clickable link to the screen the
# user needs. When it is unset they name the screen without revealing a host.
# YEEDU_UI_BASE_URL=https://yeedu.example.com

# Request timeout in seconds.
# YEEDU_API_TIMEOUT=60.0

# TLS verification. When true, YEEDU_SSL_CERT_PATH may point at a CA bundle.
# VERIFY_SSL=false
# YEEDU_SSL_CERT_PATH=

# Transport: stdio (default, for a local MCP client) or streamable-http.
# YEEDU_MCP_TRANSPORT=stdio
# YEEDU_MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Connection pool sizing. The defaults suit a single interactive client.
# YEEDU_POOL_SIZE=10
# YEEDU_POOL_MAX_CONNECTIONS=100
# YEEDU_POOL_MAX_KEEPALIVE=50
# YEEDU_POOL_MAX_CONCURRENT=500

# DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO
